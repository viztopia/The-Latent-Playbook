---
import PlayLayout from '../../layouts/PlayLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const plays = await getCollection('plays');
  return plays.map((play) => ({
    params: { slug: play.slug },
    props: { play },
  }));
}

interface Props {
  play: CollectionEntry<'plays'>;
}

const { play } = Astro.props as Props;
const { Content } = await play.render();

const getLocalDate = (date: string | Date) => {
	const d = new Date(date);
	return new Date(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
};
---

<PlayLayout
  title={play.data.title}
  description={play.data.description}
  publishDate={getLocalDate(play.data.publishDate)}
  lastUpdated={play.data.lastUpdated ? getLocalDate(play.data.lastUpdated) : undefined}
  category={play.data.category}
  author={play.data.author}
  authorUrl={play.data.authorUrl}
  heroMedia={play.data.heroMedia}
  difficulty={play.data.difficulty}
>
  <Content />
</PlayLayout>
