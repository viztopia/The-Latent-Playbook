---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayCard from '../../components/PlayCard.astro';

const categories = [
  'Character Consistency',
  'Motion & Animation',
  'World Building & Style',
  'Post-Production & Effects',
] as const;

const plays = (await getCollection('plays')).sort((a, b) => {
	const aDate = new Date(a.data.publishDate);
	const bDate = new Date(b.data.publishDate);
	aDate.setUTCHours(0, 0, 0, 0);
	bDate.setUTCHours(0, 0, 0, 0);
	return bDate.getTime() - aDate.getTime();
});

const grouped = categories.map((category) => ({
  category,
  items: plays.filter((play) => play.data.category === category),
}));
---

<BaseLayout title="Plays">
  <section class="space-y-6">
    <h1 class="font-heading text-4xl leading-tight text-text">Browse all plays</h1>
    <p class="text-lg text-text/85">
      Explore practical workflows for generative filmmaking. Use the category shortcuts below to jump to a section.
    </p>
    <div class="flex flex-wrap gap-3">
      {grouped.map(({ category }) => (
        <a
          href={`#${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="rounded-full border border-accent/40 px-4 py-2 text-xs uppercase tracking-[0.35em] text-accent transition ease-smooth duration-200 hover:border-accent hover:text-text"
        >
          {category}
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 space-y-16">
    {grouped.map(({ category, items }) => (
      <div id={category.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="font-heading text-3xl text-text">{category}</h2>
          <span class="text-sm text-textMuted">{items.length} play{items.length === 1 ? '' : 's'}</span>
        </div>
        {items.length > 0 ? (
          <div class="grid gap-8 md:grid-cols-2">
            {items.map((play) => (
              <PlayCard play={play} />
            ))}
          </div>
        ) : (
          <p class="text-textMuted">Nothing published here yet—check back soon.</p>
        )}
      </div>
    ))}
  </section>
</BaseLayout>
