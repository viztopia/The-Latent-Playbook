---
const navItems = [
  { href: import.meta.env.BASE_URL, label: 'Home' },
  { href: `${import.meta.env.BASE_URL}/plays/`, label: 'Plays' },
  { href: `${import.meta.env.BASE_URL}/about/`, label: 'About' },
];
---

<header class="bg-background/80 backdrop-blur border-b border-border/60">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 md:px-10">
    <a href="/The-Latent-Playbook" class="flex items-center gap-2 text-lg font-heading uppercase tracking-[0.35em] text-text hover:text-accent transition ease-smooth duration-200">
      <span class="text-sm font-body uppercase tracking-[0.5em] text-accent">Hypercinema </span>
      <span class="hidden border-l border-border/80 pl-3 text-base font-heading text-text md:inline">The Latent Playbook</span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-body">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class="text-text/90 transition ease-smooth duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
